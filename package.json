{
  "name": "dsh-session-lock",
  "version": "0.1.0",
  "description": "Add a per-session lock to the DSH Web sidebar; archiving a locked session through the client is refused. 在 DSH 侧栏给会话加锁，经客户端归档时会被拒绝。",
  "license": "MIT",
  "author": "Setsuna-Kitahara",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Setsuna-Kitahara/dsh-session-lock.git"
  },
  "homepage": "https://github.com/Setsuna-Kitahara/dsh-session-lock#readme",
  "bugs": {
    "url": "https://github.com/Setsuna-Kitahara/dsh-session-lock/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/archive-inactive.test.mjs && node test/client-decoration.test.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "session",
    "archive",
    "lock",
    "session-lock",
    "web-ui"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.5-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
